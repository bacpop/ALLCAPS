################################################################################
# Snakefile
################################################################################
configfile: "config.yaml"
RESULTS_DIR = config["results_dir"]

rule all:
    input:
        f"{RESULTS_DIR}/base_embeddings.npy",
        f"{RESULTS_DIR}/base_umap.pdf",
        f"{RESULTS_DIR}/contrastive_head.pth",
        f"{RESULTS_DIR}/contrastive_embeddings.npy",
        f"{RESULTS_DIR}/contrastive_umap.pdf",
        f"{RESULTS_DIR}/knn_report.txt",
        f"{RESULTS_DIR}/confusion_matrix_df.csv",
        f"{RESULTS_DIR}/f1_distributions.pdf"

################################################################################
# Produce base embeddings using the frozen Nucleotide Transformer
################################################################################
rule embed_transformer:
    input:
        fasta=config["fasta"]
    output:
        protected(f"{RESULTS_DIR}/base_embeddings.npy")
    params:
        model_name=config["model_name"],
        device=config["device"]
    shell:
        """
        python scripts/embed_transformer.py \
            --fasta {input.fasta} \
            --output {output} \
            --model_name {params.model_name} \
            --device {params.device}
        """

################################################################################
# Visualize the base Transformer embeddings with t-SNE
################################################################################
rule visualize_base_tsne:
    input:
        embeddings=f"{RESULTS_DIR}/base_embeddings.npy",
        labels=config["labels"]
    output:
        f"{RESULTS_DIR}/base_tsne.pdf"
    shell:
        """
        python scripts/tsne_visualize.py \
            --embeddings {input.embeddings} \
            --labels {input.labels} \
            --output {output} \
            --title "Base Transformer Embeddings t-SNE"
        """

rule visualize_umap:
    input:
        embeddings=f"{RESULTS_DIR}/base_embeddings.npy",
        labels=config["labels"]
    output:
        f"{RESULTS_DIR}/base_umap.pdf"
    shell:
        """
        python scripts/umap_visualize.py \
            --embeddings {input.embeddings} \
            --labels {input.labels} \
            --output {output} \
            --title "Base Transformer Embeddings UMAP"
        """

################################################################################
# Train a contrastive head on top of the frozen embeddings
################################################################################
rule train_contrastive:
    input:
        embeddings=f"{RESULTS_DIR}/base_embeddings.npy",
        labels=config["labels"]
    output:
        f"{RESULTS_DIR}/contrastive_head.pth"
    params:
        device=config["device"],
        epochs=config["epochs"],
        batch_size=config["batch_size"],
        lr=config["lr"]
    shell:
        """
        python scripts/train_contrastive.py \
            --embeddings {input.embeddings} \
            --labels {input.labels} \
            --output {output} \
            --device {params.device} \
            --epochs {params.epochs} \
            --batch_size {params.batch_size} \
            --lr {params.lr} \
            --model-params '{config[model_params]}' \
            --labeled-only \
            --hierarchical-loss
        """

################################################################################
# Use the trained contrastive head to transform embeddings
################################################################################
rule embed_contrastive:
    input:
        embeddings=f"{RESULTS_DIR}/base_embeddings.npy",
        head=f"{RESULTS_DIR}/contrastive_head.pth"
    output:
        f"{RESULTS_DIR}/contrastive_embeddings.npy"
    params:
        device=config["device"]
    shell:
        """
        python scripts/infer_contrastive.py \
            --embeddings {input.embeddings} \
            --head {input.head} \
            --output {output} \
            --device {params.device}
        """

rule knn_inference:
    input:
        embeddings=f"{RESULTS_DIR}/contrastive_embeddings.npy",
        labels=config["labels"]
    output:
        f"{RESULTS_DIR}/knn_report.txt"
        f"{RESULTS_DIR}/confusion_matrix_df.csv"
    shell:
        """
        python scripts/knn_inference.py \
            --embeddings {input.embeddings} \
            --labels {input.labels} \
            --knn_k {config[knn_k]} \
            --output-dir {RESULTS_DIR}
        """

################################################################################
# Visualize the new contrastive embeddings with t-SNE
################################################################################
rule visualize_contrastive_tsne:
    input:
        embeddings=f"{RESULTS_DIR}/contrastive_embeddings.npy",
        labels=config["labels"]
    output:
        f"{RESULTS_DIR}/contrastive_tsne.pdf"
    shell:
        """
        python scripts/tsne_visualize.py \
            --embeddings {input.embeddings} \
            --labels {input.labels} \
            --output {output} \
            --title "Contrastive Embeddings t-SNE"
        """

rule visualize_contrastive_umap:
    input:
        embeddings=f"{RESULTS_DIR}/contrastive_embeddings.npy",
        labels=config["labels"]
    output:
        f"{RESULTS_DIR}/contrastive_umap.pdf"
    shell:
        """
        python scripts/umap_visualize.py \
            --embeddings {input.embeddings} \
            --labels {input.labels} \
            --output {output} \
            --title "Contrastive Embeddings UMAP"
        """

rule stats_summary:
    """
    Generate a lineplot of class-wise F1 distributions for
    each confusion matrix to compare analysis methods.
    """
    input:
        cm_files=[f"{RESULTS_DIR}/confusion_matrix_df.csv"]
    params:
        legend_labels=["Analysis"],
    output:
        f"{RESULTS_DIR}/f1_distributions.pdf"
    shell:
        """
        python scripts/plot_f1_distributions.py \
            --confusion_matrices {input.cm_files} \
            --output {output}
        """
