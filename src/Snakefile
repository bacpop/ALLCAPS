        f"{RESULTS_DIR}/loo/{{heldout}}/classification_report.txt",
        f"{RESULTS_DIR}/loo/{{heldout}}/confusion_matrix_df.csv"
    params:
        device=config["device"],
        batch_size=config["batch_size"],
        model_params=config["model_params"]
    threads: 2
    # resources: gpu=1, mem_mb=8000
    shell:
        """
        python scripts/serotype_classifier.py \
            --embeddings {input.embeddings} \
            --model {input.model} \
            --labels {input.labels} \
            --output_dir {RESULTS_DIR}/loo/{wildcards.heldout} \
            --device {params.device} \
            --batch_size {params.batch_size} \
            --model_params '{params.model_params}' \
            --skip_label {wildcards.heldout}
        """

