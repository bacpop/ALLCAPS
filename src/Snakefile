rule novel_detection:
    input:
        labels=f"{RESULTS_DIR}/final_metadata.tsv",
        trained_model=f"{RESULTS_DIR}/transformer_model.pth",
        openmax_params=f"{RESULTS_DIR}/openmax_params.pkl",
    params:
        query=config["query_path"],
        model_params=config["model_params"],
        base_model=config["base_model"],
        head_model="transformer_trihead_lr",
    output:
        f"{RESULTS_DIR}/query_results.csv",
    shell:
        """
        python -m scripts.trihead.process_trihead_query \
            --query {params.query} \
            --output_dir {RESULTS_DIR} \
            --base_model {params.base_model} \
            --head_model {params.head_model} \
            --model_path {input.trained_model} \
            --model_params '{params.model_params}' \
            --inference_mode eval \
            --openmax_params {input.openmax_params}
        """

rule openmax_calibration:
    """Fit OpenMax parameters on the training set's projected embeddings."""
    input:
        embeddings=f"{RESULTS_DIR}/inference_results.npz",
        model=f"{RESULTS_DIR}/transformer_model.pth",
        labels=f"{RESULTS_DIR}/final_metadata.tsv",
    output:
        f"{RESULTS_DIR}/openmax_params.pkl",
    params:
        device=config["device"],
        model_params=config["model_params"],
    shell:
        """
        python -m scripts.openmax fit \
            --embeddings {input.embeddings} \
            --labels {input.labels} \
            --model {input.model} \
            --output {output} \
            --device {params.device}
        """

rule openmax_calibration_loo:
    """For each held-out serotype, fit OpenMax on the remaining serotypes — 
    enables evaluation of whether OpenMax correctly rejects the held-out serotype."""
    input:
        embeddings=f"{RESULTS_DIR}/loo/{{heldout}}/inference_results.npz",
        model=f"{RESULTS_DIR}/loo/{{heldout}}/transformer_model.pth",
        labels=f"{RESULTS_DIR}/final_metadata.tsv",
    output:
        f"{RESULTS_DIR}/loo/{{heldout}}/openmax_params.pkl",
    params:
        device=config["device"],
    shell:
        """
        python -m scripts.openmax fit \
            --embeddings {input.embeddings} \
            --labels {input.labels} \
            --model {input.model} \
            --output {output} \
            --device {params.device}
        """
