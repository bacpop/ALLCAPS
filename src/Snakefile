rule labels_postprocessing:
    input:
        labels=config["labels"],  # TODO uncomment preprocessing
        cbl_dir=f"{RESULTS_DIR}/base_embeddings_chunked/cbl",
        noncbl_dir=f"{RESULTS_DIR}/base_embeddings_chunked/non-cbl",
    output:
        f"{RESULTS_DIR}/final_metadata.tsv"
    shell:
        """
        python scripts/labels_postprocessing.py \
            --clean_labels {input.labels} \
            --output_dir {RESULTS_DIR}
        """

rule train_model:
    input:
        embeddings=f"{RESULTS_DIR}/base_embeddings_chunked",
        labels=f"{RESULTS_DIR}/final_metadata.tsv"
    output:
        protected(f"{RESULTS_DIR}/transformer_model.pth")
    params:
        device=config["device"],
        epochs=config["epochs"],
        batch_size=config["batch_size"],
        lr=config["lr"]
    shell:
        """
        python scripts/train_lr_transformer.py \
            --embedding_dir {input.embeddings} \
            --labels {input.labels} \
            --output {output} \
            --device {params.device} \
            --epochs {params.epochs} \
            --batch_size {params.batch_size} \
            --lr {params.lr} \
            --model_params '{config[model_params]}' \
            --labeled_only \
            --hierarchical_loss
        """

