rule novel_detection:
    input:
        labels=f"{config['data_dir']}/final_metadata.csv",
        trained_model=f"{RESULTS_DIR}/transformer_model.pth",
    params:
        query=config["query_path"],
        model_params=config["model_params"],
        base_model=config["base_model"],
        head_model="transformer_trihead_lr",
    output:
        results=f"{RESULTS_DIR}/query_results.csv",
        embeddings=f"{RESULTS_DIR}/query_embeddings.npz",
    shell:
        """
        python -m scripts.trihead.process_trihead_query \
            --query {params.query} \
            --output_dir {RESULTS_DIR} \
            --base_model {params.base_model} \
            --head_model {params.head_model} \
            --model_path {input.trained_model} \
            --model_params '{params.model_params}' \
            --inference_mode eval
        """


# ═══════════════════════════════════════════════════════════════
#  kNN novelty detection (the deployed detector)
#
#  Scores a query's cosine distance to the k-th nearest *training* cps embedding.
#  `novel_detection` above reports the energy baseline; these rules add the kNN
#  call. Defaults match the deployed configuration: k=1, threshold at the 95th
#  percentile of the training leave-one-out k-th-NN distances.
# ═══════════════════════════════════════════════════════════════

KNN_K = config.get("knn_k", 1)
KNN_PERCENTILE = config.get("knn_threshold_percentile", 95.0)
KNN_MAX_K = config.get("knn_max_k", 5)


rule knn_fit:
    """Build the nearest-neighbour index from the training (in-distribution) embeddings."""
    input:
        embeddings=f"{RESULTS_DIR}/inference_results.npz",
        labels=f"{config['data_dir']}/final_metadata.csv",
    output:
        f"{RESULTS_DIR}/knn_index.pkl",
    params:
        k=KNN_K,
    shell:
        """
        python -m scripts.knn_ood fit \
            --embeddings {input.embeddings} \
            --labels {input.labels} \
            --output {output} \
            --k {params.k} \
            --distance_metric cosine
        """


rule knn_predict_id:
    """Score the training set against its own index (self-match excluded).

    Every serotype here is in-distribution, so the flagged fraction is the
    false-positive rate at the chosen threshold — the honest calibration check."""
    input:
        embeddings=f"{RESULTS_DIR}/inference_results.npz",
        labels=f"{config['data_dir']}/final_metadata.csv",
        knn_index=f"{RESULTS_DIR}/knn_index.pkl",
    output:
        f"{RESULTS_DIR}/knn_id_distances.csv",
    params:
        percentile=KNN_PERCENTILE,
    shell:
        """
        python -m scripts.knn_ood predict \
            --input_type id \
            --embeddings {input.embeddings} \
            --labels {input.labels} \
            --knn_index {input.knn_index} \
            --threshold_percentile {params.percentile} \
            --output {output}
        """


rule knn_predict_query:
    """Score the query embeddings written by `novel_detection`.

    `--max_k` additionally writes `<output>_topk.csv`, a long-format table of the
    top-K neighbours per query (rank, neighbour id, serotype, genogroup, distance)."""
    input:
        embeddings=f"{RESULTS_DIR}/query_embeddings.npz",
        knn_index=f"{RESULTS_DIR}/knn_index.pkl",
    output:
        distances=f"{RESULTS_DIR}/knn_query_distances.csv",
        topk=f"{RESULTS_DIR}/knn_query_distances_topk.csv",
    params:
        percentile=KNN_PERCENTILE,
        max_k=KNN_MAX_K,
    shell:
        """
        python -m scripts.knn_ood predict \
            --input_type query \
            --embeddings {input.embeddings} \
            --knn_index {input.knn_index} \
            --threshold_percentile {params.percentile} \
            --max_k {params.max_k} \
            --output {output.distances}
        """
