import sys, os

# `workflow.basedir` is this Snakefile's directory. Do NOT use __file__ here — inside a
# Snakefile it resolves to snakemake's own workflow.py, so the append silently pointed at
# the snakemake install and `from consts import *` failed with ModuleNotFoundError.
sys.path.append(os.path.join(workflow.basedir, "scripts"))

from consts import *

configfile: "config.yaml"
RESULTS_DIR = config["results_dir"]

# Validation function for model parameters
def validate_model_params(config):
    required_keys = ["embedding_dim"]  # Important keys. Probably should be require arguments, but whatever.
    model_params = config.get("model_params", {})
    missing_keys = [key for key in required_keys if key not in model_params]
    if missing_keys:
        raise ValueError(f"Missing required model_params keys: {missing_keys}")

# Validate configuration on load
validate_model_params(config)

# List of serotypes to iterate over for LOO (must be provided in config.yaml)
SEROTYPES = config["serotypes"]

rule all:
    input:
        # Data preprocessing outputs
        f"{config['data_dir']}/train.fasta",
        f"{config['data_dir']}/test.fasta",
        # Labels processing outputs
        f"{RESULTS_DIR}/cleaned_labels.csv",
        f"{config['data_dir']}/final_metadata.csv",
        # Embedding directory (flat)
        directory(f"{RESULTS_DIR}/base_embeddings_chunked"),
        # Model and processing outputs
        f"{RESULTS_DIR}/transformer_model.pth",
        f"{RESULTS_DIR}/inference_results.npz",
        # Visualization and analysis outputs
        f"{RESULTS_DIR}/cbl_results.txt",
        f"{RESULTS_DIR}/serotype_predictions.txt",
        f"{RESULTS_DIR}/serotype_confidence_stats.tsv",
        f"{RESULTS_DIR}/classification_report.txt",
        f"{RESULTS_DIR}/confusion_matrix_df.csv",
        # Novel detection outputs — energy (query_results) + kNN (deployed detector)
        f"{RESULTS_DIR}/query_results.csv",
        f"{RESULTS_DIR}/knn_id_distances.csv",
        f"{RESULTS_DIR}/knn_query_distances.csv",
        # LOO targets (one set per held-out serotype)
        expand(f"{RESULTS_DIR}/loo/{{heldout}}/classification_report.txt", heldout=SEROTYPES),
        expand(f"{RESULTS_DIR}/loo/{{heldout}}/confusion_matrix_df.csv", heldout=SEROTYPES),
        expand(f"{RESULTS_DIR}/loo/{{heldout}}/serotype_predictions.txt", heldout=SEROTYPES),
        expand(f"{RESULTS_DIR}/loo/{{heldout}}/serotype_confidence_stats.tsv", heldout=SEROTYPES)

rule locus_cutting:
    """Cut CBL loci from raw FASTA files; produces CBL and non-CBL sequences."""
    input:
        infiles=config["infiles"],
    params:
        query=config["locus_cutter_query"],
        outpref=f"{config['data_dir']}/contigs",
        cutoff=config.get("locus_cutter_cutoff", 0.7),
        max_extension=config.get("locus_cutter_max_extension", 1e9)
    output:
        f"{config['data_dir']}/contigs_cleaned.fasta",
        f"{config['data_dir']}/contigs_noncbl_cleaned.fasta"
    shell:
        """
        python -m scripts.data_locus_cutter \
            --infiles {input.infiles} \
            --cutoff {params.cutoff} \
            --query {params.query} \
            --outpref {params.outpref} \
            --max_extension {params.max_extension} \
            --save-noncbl
        """

rule labels_preprocessing:
    input:
        config["metadata"]
    output:
        f"{RESULTS_DIR}/cleaned_labels.csv"
    shell:
        """
        python -m scripts.data_labels_preprocessing \
            --metadata {input} \
            --output_dir {RESULTS_DIR}
        """

rule train_test_split:
    """Combine multiple FASTA/metadata sources and stratified-split into train/test."""
    input:
        cbl=f"{config['data_dir']}/contigs_cleaned.fasta",
        noncbl=f"{config['data_dir']}/contigs_noncbl_cleaned.fasta",
        labels=f"{RESULTS_DIR}/cleaned_labels.csv"
    params:
        fastas=" ".join(config.get("split_fastas", [])),
        metadata=" ".join(config.get("split_metadata", [])),
        ratios=config.get("split_ratios", "0.9"),
    output:
        f"{config['data_dir']}/train.fasta",
        f"{config['data_dir']}/test.fasta",
        f"{config['data_dir']}/train_metadata.csv",
        f"{config['data_dir']}/test_metadata.csv",
    shell:
        """
        python -m scripts.helpers.data_train_test_split \
            --fastas {params.fastas} \
            --metadata {params.metadata} \
            --ratios {params.ratios} \
            --output_dir {config[data_dir]}
        """

rule embed_base:
    """Compute ProKBERT chunk embeddings for all training sequences (flat output dir)."""
    input:
        fasta=f"{config['data_dir']}/train.fasta"
    output:
        directory(f"{RESULTS_DIR}/base_embeddings_chunked")
    params:
        base_model=config.get("base_model", "neuralbioinfo/prokbert-mini-long"),
        device=config.get("device", "cuda"),
        chunk_size=config.get("chunk_size", 4000),
        stride_ratio=config.get("stride_ratio", 0.5),
        seq_max_len=config.get("seq_max_len", 30_000)
    shell:
        """
        python -m scripts.embed_transformer \
            --fasta {input.fasta} \
            --out_dir {output} \
            --device {params.device} \
            --model_name {params.base_model} \
            --chunk_size {params.chunk_size} \
            --stride_ratio {params.stride_ratio} \
            --seq_max_len {params.seq_max_len}
        """

rule labels_postprocessing:
    """Filter metadata to only samples that have a matching embedding file."""
    input:
        labels=f"{config['data_dir']}/train_metadata.csv",
        emb_dir=f"{RESULTS_DIR}/base_embeddings_chunked",
    output:
        f"{config['data_dir']}/final_metadata.csv"
    shell:
        """
        python -m scripts.data_labels_postprocessing \
            --clean_labels {input.labels} \
            --embedding_dir {input.emb_dir} \
            --output_dir {config[data_dir]}
        """

rule train_model:
    input:
        embeddings=f"{RESULTS_DIR}/base_embeddings_chunked",
        labels=f"{config['data_dir']}/final_metadata.csv"
    output:
        protected(f"{RESULTS_DIR}/transformer_model.pth")
    params:
        device=config["device"],
        epochs=config["epochs"],
        batch_size=config["batch_size"],
        lr=config["lr"],
        model_params=config["model_params"]
    shell:
        """
        python -m scripts.trihead.train_trihead_transformer \
            --embedding_dir {input.embeddings} \
            --labels {input.labels} \
            --output {output} \
            --device {params.device} \
            --epochs {params.epochs} \
            --batch_size {params.batch_size} \
            --lr {params.lr} \
            --model_params '{params.model_params}' \
            --labeled_only \
            --hierarchical_loss
        """

