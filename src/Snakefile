        """

rule labels_preprocessing:
    input:
        config["metadata"]
    output:
        f"{RESULTS_DIR}/cleaned_labels.csv"
    shell:
        """
        python -m scripts.data_labels_preprocessing \
            --metadata {input} \
            --output_dir {RESULTS_DIR}
        """

rule labels_postprocessing:
    input:
        labels=f"{RESULTS_DIR}/cleaned_labels.csv",
        cbl_dir=f"{RESULTS_DIR}/base_embeddings_chunked/cbl",
        noncbl_dir=f"{RESULTS_DIR}/base_embeddings_chunked/non-cbl",
    params:
        skip_labels=",".join(config.get("skip_labels", [])),
        label_column=config.get("label_column", "Serotype")
    output:
        f"{RESULTS_DIR}/final_metadata.tsv"
    shell:
        """
        python -m scripts.data_labels_postprocessing \
            --clean_labels {input.labels} \
            --output_dir {RESULTS_DIR} \
            --skip_labels {params.skip_labels} \
            --label_column {params.label_column}
        """

rule train_model:
    input:
        embeddings=f"{RESULTS_DIR}/base_embeddings_chunked",
        labels=f"{RESULTS_DIR}/final_metadata.tsv"
    output:
        protected(f"{RESULTS_DIR}/transformer_model.pth")
    params:
        device=config["device"],
        epochs=config["epochs"],
        batch_size=config["batch_size"],
        lr=config["lr"],
        model_params=config["model_params"]
    shell:
        """
        python -m scripts.trihead.train_trihead_transformer \
            --embedding_dir {input.embeddings} \
            --labels {input.labels} \
            --output {output} \
            --device {params.device} \
            --epochs {params.epochs} \
            --batch_size {params.batch_size} \
            --lr {params.lr} \
            --model_params '{params.model_params}' \
            --labeled_only \
            --hierarchical_loss
        """

rule embed_chunks:
    input:
        embeddings_dir=f"{RESULTS_DIR}/base_embeddings_chunked",
        labels=f"{RESULTS_DIR}/final_metadata.tsv",
        model=f"{RESULTS_DIR}/transformer_model.pth"
    output:
        f"{RESULTS_DIR}/inference_results.npz"
    params:
        device=config["device"],
        batch_size=config["batch_size"],
        model_params=config["model_params"]
    shell:
        """
        python -m scripts.trihead.infer_trihead_transformer \
            --embeddings_dir {input.embeddings} \
            --labels {input.labels} \
            --model {input.model} \
            --output {output} \
            --device {params.device} \
            --batch_size {params.batch_size} \
            --model_params '{params.model_params}' \
            --labeled_only
        """

