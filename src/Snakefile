# Leave-one-out (LOO) workflow
rule train_model_loo:
    input:
        embeddings_dir=f"{RESULTS_DIR}/base_embeddings_chunked",
        labels=f"{RESULTS_DIR}/final_metadata.tsv"
    output:
        f"{RESULTS_DIR}/loo/{{heldout}}/transformer_model.pth"
    params:
        device=config["device"],
        epochs=config["epochs"],
        batch_size=config["batch_size"],
        lr=config["lr"],
        model_params=config["model_params"]
    threads: 4
    # resources: gpu=1, mem_mb=32000  # optionally control resources
    shell:
        """
        python scripts/train_lr_transformer.py \
            --embedding_dir {input.embeddings_dir} \
            --labels {input.labels} \
            --output {output} \
            --device {params.device} \
            --epochs {params.epochs} \
            --batch_size {params.batch_size} \
            --lr {params.lr} \
            --model_params '{params.model_params}' \
            --labeled_only \
            --hierarchical_loss \
            --skip_label {wildcards.heldout}
        """

rule embed_chunks_loo:
    input:
        embeddings_dir=f"{RESULTS_DIR}/base_embeddings_chunked",
        labels=f"{RESULTS_DIR}/final_metadata.tsv",
        model=f"{RESULTS_DIR}/loo/{{heldout}}/transformer_model.pth"
    output:
        f"{RESULTS_DIR}/loo/{{heldout}}/inference_results.npz"
    params:
        device=config["device"],
        batch_size=config["batch_size"],
        model_params=config["model_params"]
    threads: 2
    # resources: gpu=1, mem_mb=16000
    shell:
        """
        python scripts/infer_lr_transformer.py \
            --embeddings_dir {input.embeddings_dir} \
            --labels {input.labels} \
            --model {input.model} \
            --output {output} \
            --device {params.device} \
            --batch_size {params.batch_size} \
            --model_params '{params.model_params}' \
            --labeled_only \
            --skip_label {wildcards.heldout}
        """

rule serotype_classification_loo:
