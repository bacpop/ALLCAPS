results_dir: "my_results"
cbl_fasta: "data/cbl_sequences.fasta"
noncbl_fasta: "data/noncbl_sequences.fasta"
data_dir: "data"
metadata: "data/monocle-metadata.tsv"
infiles: "data/infiles.txt"
locus_cutter_query: "data/dexB_aliA_ATCC700669.fasta"
label_column: "ERR"
skip_labels: []
serotypes: []  # list of serotypes for LOO expansion
labels: "data/labels.txt"
flank: "data/dexB_aliA_ATCC700669.fasta"
raw_files: "/data/fasta_paths.txt"
query_path: "/data/input_sequence.fa"
chunk_size: 4000
stride_ratio: 0.5
device: "cuda"
batch_size: 128
epochs: 10
lr: 0.001
base_model: "neuralbioinfo/prokbert-mini-long"
model_params: '{"temperature": 0.07, "k_folds": 5, "weight_fine": 1, "weight_coarse": 0.4, "random_state": 42, "embedding_dim": 384}'
sketch_k: 31
sketch_size: 10000
# kNN novelty detection (deployed configuration)
knn_k: 1                        # distance to the k-th nearest training locus
knn_threshold_percentile: 95.0  # threshold = this percentile of training LOO k-th-NN distances
knn_max_k: 5                    # also emit a top-K neighbour report per query
knn_k_grid: ""                  # e.g. "1,5,10,20,50,100,200,500,1000" — per-sample k sweep
                                # (<output>_kgrid.csv); "" = off. Needs no change to knn_k.
lda_components: 5
novelty_thresholds: "0.1,0.2,0.9,0.98"